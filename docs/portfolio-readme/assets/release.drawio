        <mxCell id="commit" parent="1" vertex="1" value="&lt;b style=&quot;font-size:23px;line-height:1.15;color:#435968&quot;&gt;정확한 Git 커밋&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;line-height:1.16;color:#34485A&quot;&gt;브랜치 이름 대신 검증할 SHA 고정&lt;/span&gt;" style="shape=document;size=0.12;fillColor=#F0F2F4;strokeColor=#ABB7C1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=5;spacingLeft=10;spacingRight=10;strokeWidth=1.4;fontFamily=Arial;">
          <mxGeometry x="61" y="220" width="233" height="104" as="geometry" />
